<Window x:Class="FLLiteStudio.UI.InstrumentBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biblioteca de Instrumentos — FL-Lite Studio"
        Width="860" Height="590"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#15181D"
        Foreground="#E6EBF2">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + Search -->
        <Border Grid.Row="0" Background="#1E232A" BorderBrush="#2E3642" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Biblioteca de Instrumentos" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="LblCount" Text="62 instrumentos listos para usar — Haz clic en Probar para escuchar antes de añadir"
                               Foreground="#93A0B3" FontSize="11.5" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Buscar:" Foreground="#93A0B3" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtSearch" Width="220" Background="#14181E" Foreground="White" BorderBrush="#3E4858"
                             Padding="8,5" FontSize="12" TextChanged="TxtSearch_TextChanged"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body: Categories Left + Instrument Cards Right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Categories Sidebar -->
            <Border Grid.Column="0" Background="#191D24" BorderBrush="#2C3440" BorderThickness="0,0,1,0" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CategoriesPanel"/>
                </ScrollViewer>
            </Border>

            <!-- Instrument List -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="12">
                <StackPanel x:Name="InstrumentsPanel"/>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#1B2027" BorderBrush="#2E3642" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <TextBlock x:Name="LblFooterStatus" Text="Consejo: puedes añadir varios instrumentos seguidos y cerrar al terminar."
                           Foreground="#93A0B3" FontSize="11" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Listo / Cerrar" Style="{StaticResource AccentButton}" Padding="16,5" Click="BtnClose_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
